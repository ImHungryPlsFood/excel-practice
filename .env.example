# 환경 변수 예시 파일. 실제 값은 .env.local에 작성하며 절대 커밋하지 않는다 (THREAT_MODEL S-11).
# VITE_ 접두사 변수는 클라이언트 번들에 평문으로 포함된다. 비밀 키에는 절대 VITE_를 붙이지 않는다 (S-06).
# Firebase Web 앱 구성값은 공개 식별자이며, 보호는 보안 규칙·API 키 리퍼러 제한·App Check로 한다.

# Firebase (CARD-06A에서 사용)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Firebase App Check reCAPTCHA Enterprise 사이트 키 (S-05, CARD-06A)
VITE_FIREBASE_APPCHECK_SITE_KEY=

# GPLv3 소스 공개 저장소 URL (ADR-001 §4.2, CARD-01B 푸터에서 사용)
VITE_SOURCE_REPOSITORY_URL=
